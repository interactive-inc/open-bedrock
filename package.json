{
  "name": "open-karte",
  "private": true,
  "workspaces": [
    "api",
    "cli",
    "web"
  ],
  "type": "module",
  "scripts": {
    "build:api-types": "bun run --filter api build:types",
    "typecheck": "bun run build:api-types && bun run --filter web check && bun run --filter cli check",
    "test:web": "bun run --filter web test",
    "check": "vp check"
  },
  "devDependencies": {
    "@interactive-inc/claude-funnel": "^0.60.1",
    "vite-plus": "^0.1.24"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "postcss": "8.5.15",
    "ws": "8.21.0"
  },
  "packageManager": "bun@1.3.14"
}
