{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run build:types && tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "bun test",
    "db:repair-migration-history:local": "bunx wrangler d1 execute bedrock --local --file=./scripts/repair-migration-history.sql",
    "db:repair-migration-history": "bunx wrangler d1 execute bedrock --remote --file=./scripts/repair-migration-history.sql",
    "db:migrate:local": "bun run db:repair-migration-history:local && wrangler d1 migrations apply bedrock --local",
    "db:migrate": "bun run db:repair-migration-history && wrangler d1 migrations apply bedrock --remote",
    "db:seed:local": "bash scripts/seed.sh --local",
    "db:seed": "bash scripts/seed.sh --remote",
    "build:types:bundle": "tsc -p tsconfig.build.json && dts-bundle-generator -o dist/app.bundle.d.ts dist/app.d.ts --project tsconfig.dts.json --no-check --external-inlines drizzle-orm --external-inlines zod"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "jose": "^5.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "^1.3.14",
    "dts-bundle-generator": "9.5.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.107.0"
  }
}
