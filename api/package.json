{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run build:types && tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "bun test",
    "db:migrate:local": "wrangler d1 migrations apply open-karte --local",
    "db:migrate": "wrangler d1 migrations apply open-karte --remote",
    "db:seed:local": "bash scripts/seed.sh --local",
    "db:seed": "bash scripts/seed.sh --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "jose": "^5.9.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "@types/bun": "^1.3.14",
    "wrangler": "^4.4.0"
  }
}
