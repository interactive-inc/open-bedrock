{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["bun", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@system/application/*": ["./src/application/system/*"],
      "@system/domain/*": ["./src/domain/system/*"],
      "@system/infrastructure/*": ["./src/infrastructure/system/*"]
    }
  }
}
