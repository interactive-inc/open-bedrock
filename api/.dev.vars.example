# このファイルは公開リポジトリに入るため、実際に使える秘密値を書かない。
# `bun run setup:dev-vars` を実行すると .dev.vars がランダムな秘密値付きで生成される。
# 手で用意する場合は `openssl rand -base64 32` の出力を使う。
#
# api は「未設定」「16 文字未満」「-change-me で終わる値」を実行時に拒否する。
JWT_SECRET=
AUDIT_HMAC_SECRET=
# local seedのpassword hash専用。本番では必ず別のランダムsecretを設定する。
PEPPER_SECRET="open-bedrock-local-seed-pepper"
# 添付の DEK を包む KEK。{"version": "base64 32 バイト"} 形式で、最大 version が現行鍵。
# ローテーション中は旧 version も残す。未設定なら添付 API は 503 を返す。
ATTACHMENT_KEKS=
COMPANY_TIME_ZONE="Asia/Tokyo"
# 外部 identity 同期を使うときだけ設定する。未設定なら /provisioning/* は全拒否。
PROVISIONING_API_KEY=
IDENTITY_JWKS=
IDENTITY_ISSUER="http://localhost:18790"
IDENTITY_AUDIENCE="https://app.bedrock.localhost"
IDENTITY_LOGIN_URL="http://localhost:18790"
API_ORIGIN="https://bedrock.localhost"
# identityログインと異なる発行者のAPI access tokenを受理する場合に設定する。
# 未設定ならIDENTITY_ISSUERを使う。
IDENTITY_ACCESS_TOKEN_ISSUER=
# API access tokenを直接受理するときだけ、そのaudienceを設定する。
# 署名鍵はIDENTITY_JWKS、未設定ならaccess token issuerのOpenID Connect discoveryから取得する。
IDENTITY_ACCESS_TOKEN_AUDIENCE=
# 初期 ROOT の作成時だけ設定し、作成後は削除する。未設定なら POST /system/bootstrap は 404。
BOOTSTRAP_TOKEN=
# 有効化する opt-in App 機能。"all" か機能キーのカンマ区切り。正本は .docs/feature-tiers.md。
ENABLED_OPT_IN_APPS="all"
