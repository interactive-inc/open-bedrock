{
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TASK_LIST_ID": "open-bedrock"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.file_path | select(test(\"\\\\.tsx?$\"))' | { read -r f; [ -n \"$f\" ] && vp fmt \"$f\" --write && vp lint \"$f\" --fix; } 2>/dev/null || true",
            "statusMessage": "vp fmt + lint",
            "type": "command"
          },
          {
            "command": "jq -e '.tool_input.file_path | test(\"/api/.*\\\\.tsx?$\")' >/dev/null && (cd api && bun test) 2>/dev/null || true",
            "statusMessage": "bun test (api)",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/scripts/funnel-gateway-check.sh",
            "statusMessage": "funnel gateway check",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true
}
